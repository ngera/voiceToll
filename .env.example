# Copy to .env and fill in. Never commit .env.

# ---------- App side (voicetoll client, inside your voice agent) ----------
VOICETOLL_ENDPOINT=http://localhost:4319
VOICETOLL_PROJECT=demo
VOICETOLL_INGEST_KEY=dev-key
# Secret used to pseudonymize tenant and user ids before they leave the app (any long random string)
VOICETOLL_HMAC_KEY=change-me-to-a-long-random-string
VOICETOLL_ENV=dev
# Server region; auto-detected from FLY_REGION / AWS_REGION / GOOGLE_CLOUD_REGION when unset
VOICETOLL_REGION=
# Set to 1 to turn every adapter into a no-op
VOICETOLL_DISABLED=0

# ---------- Collector ----------
# SQLite for local development, Postgres for anything shared
VOICETOLL_DB_URL=sqlite:///./voicetoll.db
# VOICETOLL_DB_URL=postgresql://voicetoll:voicetoll@localhost:5432/voicetoll
# project=key pairs, comma separated
VOICETOLL_INGEST_KEYS=demo=dev-key
VOICETOLL_SPOOL_DIR=./spool
VOICETOLL_SPOOL_MAX_MB=1024
VOICETOLL_RATE_CARDS=./config/rate_cards.yaml
# Reconciliation accounts (see config/reconcile.example.yaml) and the keys it names.
# Use read-only or usage-scoped keys, separate from the keys the agent uses.
VOICETOLL_RECON_CONFIG=./config/reconcile.yaml
VOICETOLL_RECON_OPENAI_KEY=
VOICETOLL_RECON_ELEVENLABS_KEY=
VOICETOLL_RECON_DEEPGRAM_KEY=

# ---------- Provider keys for a test agent (not used by voiceToll itself) ----------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------- Highlights and price upkeep (defaults shown) ----------
# Voice-to-voice budget per turn, for the slowest-component highlight
VOICETOLL_V2V_BUDGET_MS=1200
# Change after a release fires beyond this share (0.15 = 15%)
VOICETOLL_RELEASE_CHANGE_THRESHOLD=0.15
VOICETOLL_HIGHLIGHT_MIN_CALLS=3
VOICETOLL_HIGHLIGHT_MIN_TURNS=20
# How often rate cards and price versions are checked; days of history re-costed when they change (0 = off)
VOICETOLL_PRICING_CHECK_SECONDS=60
VOICETOLL_AUTO_REPRICE_DAYS=45

# Admin UI at /admin (prices, reports for every project, cost, collector health). Off in a shared deploy
# until this is set; use a long random value and keep it out of source control.
VOICETOLL_ADMIN_KEY=dev-admin-key
# Rate card entries whose `reviewed` date is older than this many days are tagged stale in the admin UI
VOICETOLL_RATE_CARD_REVIEW_DAYS=90

# Pipecat test agent (examples/test_agent/pipecat_agent.py): optional voice ids and agent version tag
# VT_ELEVEN_VOICE=21m00Tcm4TlvDq8ikWAM
# VT_CARTESIA_VOICE=86e30c1d-714b-4074-a1f2-1cb6b552fb49
# VT_AGENT_VERSION_PIPECAT=g3-pipecat-v1
